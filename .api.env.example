# API only. The API owns Google credentials and verifies BFF public keys.
APP_ENV="local"
DATABASE_URL="postgresql://xuyenviet:xuyenviet@localhost:5432/xuyenviet"
XV_BFF_CREDENTIAL_CONFIG="replace-with-web-and-admin-public-verification-key-config"
XV_ADMIN_IDENTITY_HANDOFF_SERVICE_TOKEN="replace-with-admin-to-api-service-secret"
XV_ADMIN_SESSION_LOOKUP_KEY="replace-with-at-least-32-byte-api-only-session-hmac-key"
XV_ADMIN_GOOGLE_CLIENT_ID="replace-with-api-owned-admin-google-client-id"
XV_ADMIN_GOOGLE_CLIENT_SECRET="replace-with-api-owned-admin-google-client-secret"
