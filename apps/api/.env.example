# API only. The API owns Nest browser OAuth/session/CSRF.
# `APP_ENV=local` permits only exact HTTP loopback browser origins.
APP_ENV="local"
DATABASE_URL="postgresql://xuyenviet:xuyenviet@localhost:5432/xuyenviet"
ADMIN_EMAIL=""
# Nest browser OAuth only. Each allowed return URL is a comma-separated, canonical
# href and must exactly match the requested returnUrl (including any query).
XV_BROWSER_GOOGLE_CLIENT_ID="replace-with-api-owned-browser-google-client-id"
XV_BROWSER_GOOGLE_CLIENT_SECRET="replace-with-api-owned-browser-google-client-secret"
XV_BROWSER_GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
XV_BROWSER_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3003,http://localhost:3001"
XV_BROWSER_ALLOWED_RETURN_URLS="http://localhost:3000/,http://localhost:3000/ai-ask,http://localhost:3000/sign-in,http://localhost:3003/"
XV_BROWSER_SESSION_LOOKUP_KEY="replace-with-at-least-32-byte-browser-session-hmac-key"
XV_BROWSER_CSRF_KEY="replace-with-at-least-32-byte-browser-csrf-hmac-key"
XV_BROWSER_OAUTH_TRANSACTION_PROTECTION_KEY="replace-with-at-least-32-byte-browser-oauth-protection-key"
