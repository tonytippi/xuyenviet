# API only. The API owns Google credentials and verifies BFF public keys.
APP_ENV="local"
XV_ADMIN_LOCAL_TRANSPORT="false"
DATABASE_URL="postgresql://xuyenviet:xuyenviet@localhost:5432/xuyenviet"
ADMIN_EMAIL=""
XV_BFF_CREDENTIAL_CONFIG="replace-with-web-and-admin-public-verification-key-config"
XV_ADMIN_IDENTITY_HANDOFF_SERVICE_TOKEN="replace-with-admin-to-api-service-secret"
XV_ADMIN_SESSION_LOOKUP_KEY="replace-with-at-least-32-byte-api-only-session-hmac-key"
XV_ADMIN_GOOGLE_CLIENT_ID="replace-with-api-owned-admin-google-client-id"
XV_ADMIN_GOOGLE_CLIENT_SECRET="replace-with-api-owned-admin-google-client-secret"
# Nest browser OAuth only. Each allowed return URL is a comma-separated, canonical
# HTTPS href and must exactly match the requested returnUrl (including any query).
XV_BROWSER_GOOGLE_CLIENT_ID="replace-with-api-owned-browser-google-client-id"
XV_BROWSER_GOOGLE_CLIENT_SECRET="replace-with-api-owned-browser-google-client-secret"
XV_BROWSER_GOOGLE_CALLBACK_URL="https://web.xuyenviet.vn/auth/google/callback"
XV_BROWSER_ALLOWED_ORIGINS="https://web.xuyenviet.vn"
XV_BROWSER_ALLOWED_RETURN_URLS="https://web.xuyenviet.vn/trips"
XV_BROWSER_SESSION_LOOKUP_KEY="replace-with-at-least-32-byte-browser-session-hmac-key"
XV_BROWSER_CSRF_KEY="replace-with-at-least-32-byte-browser-csrf-hmac-key"
XV_BROWSER_OAUTH_TRANSACTION_PROTECTION_KEY="replace-with-at-least-32-byte-browser-oauth-protection-key"
