# API only. The API owns Nest browser OAuth/session/CSRF and verifies the retained web BFF public key.
APP_ENV="local"
DATABASE_URL="postgresql://xuyenviet:xuyenviet@localhost:5432/xuyenviet"
ADMIN_EMAIL=""
XV_BFF_CREDENTIAL_CONFIG="replace-with-web-public-verification-key-config"
# Nest browser OAuth only. Each allowed return URL is a comma-separated, canonical
# HTTPS href and must exactly match the requested returnUrl (including any query).
XV_BROWSER_GOOGLE_CLIENT_ID="replace-with-api-owned-browser-google-client-id"
XV_BROWSER_GOOGLE_CLIENT_SECRET="replace-with-api-owned-browser-google-client-secret"
XV_BROWSER_GOOGLE_CALLBACK_URL="https://web.xuyenviet.vn/auth/google/callback"
XV_BROWSER_ALLOWED_ORIGINS="https://web.xuyenviet.vn,https://admin.xuyenviet.app"
XV_BROWSER_ALLOWED_RETURN_URLS="https://web.xuyenviet.vn/trips,https://admin.xuyenviet.app/,https://admin.xuyenviet.app/users,https://admin.xuyenviet.app/ai-models,https://admin.xuyenviet.app/quality,https://admin.xuyenviet.app/knowledge/intake,https://admin.xuyenviet.app/knowledge/progress,https://admin.xuyenviet.app/knowledge/facebook-captures,https://admin.xuyenviet.app/knowledge/youtube-captures,https://admin.xuyenviet.app/knowledge/drafts,https://admin.xuyenviet.app/knowledge/approved,https://admin.xuyenviet.app/knowledge/recommendations"
XV_BROWSER_SESSION_LOOKUP_KEY="replace-with-at-least-32-byte-browser-session-hmac-key"
XV_BROWSER_CSRF_KEY="replace-with-at-least-32-byte-browser-csrf-hmac-key"
XV_BROWSER_OAUTH_TRANSACTION_PROTECTION_KEY="replace-with-at-least-32-byte-browser-oauth-protection-key"
