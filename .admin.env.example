# Admin BFF only. Never add DATABASE_URL, Google credentials, XV_BFF_CREDENTIAL_CONFIG,
# or web/worker secrets to this file.
APP_ENV="local"
XV_ADMIN_BFF_ORIGIN="https://admin.xuyenviet.app"
XV_ADMIN_PRIVATE_API_URL="https://api.railway.internal"
XV_ADMIN_IDENTITY_HANDOFF_URL="https://api.railway.internal"
XV_ADMIN_IDENTITY_HANDOFF_SERVICE_TOKEN="replace-with-admin-to-api-service-secret"
XV_ADMIN_BFF_CSRF_SIGNING_SECRET="replace-with-at-least-32-character-admin-csrf-secret"
XV_ADMIN_BFF_CSRF_LIFETIME_SECONDS="300"
XV_ADMIN_BFF_REQUEST_TIMEOUT_MS="5000"
XV_ADMIN_BFF_ACTIVE_KID="admin-active"
XV_ADMIN_BFF_ACTIVE_JWK="replace-with-admin-public-es256-jwk"
XV_ADMIN_BFF_ACTIVE_PRIVATE_JWK="replace-with-admin-private-es256-jwk"
