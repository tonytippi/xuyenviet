{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@xuyenviet/contracts": ["./packages/contracts/src/index.ts"],
      "@xuyenviet/config": ["./packages/config/src/index.ts"],
      "@xuyenviet/database": ["./packages/database/src/index.ts"],
      "@xuyenviet/domain": ["./packages/domain/src/index.ts"],
      "@xuyenviet/worker-domain": ["./packages/worker-domain/src/index.ts"],
      "@xuyenviet/worker-domain/*": ["./packages/worker-domain/src/*"],
      "@worker/*": ["./packages/worker-domain/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "packages/worker-domain"]
}
