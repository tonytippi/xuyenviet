{
  "name": "xuyenviet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "api": "pnpm --filter @xuyenviet/api",
    "admin": "pnpm --filter @xuyenviet/admin",
    "worker": "pnpm --filter @xuyenviet/worker build && pnpm --filter @xuyenviet/worker start",
    "build": "next build && pnpm --filter @xuyenviet/admin build && pnpm --filter @xuyenviet/api build && pnpm --filter @xuyenviet/worker build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit && pnpm --filter @xuyenviet/admin typecheck && pnpm --filter @xuyenviet/worker-domain typecheck && pnpm --filter @xuyenviet/api typecheck && pnpm --filter @xuyenviet/worker typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-api-schema.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:local": "APP_ENV=local DB_RESET_DISPOSABLE_CONFIRMATION=confirm-disposable-reset DB_RESET_NO_RUNTIME_OVERLAP=confirm-no-runtime-overlap DB_RESET_EXPECTED_TARGET_IDENTITY='database=xuyenviet;host=127.0.0.1;port=5432' node --env-file=apps/api/.env.local --import tsx scripts/db-reset.ts",
    "bootstrap:initial-admin": "node --conditions react-server --import tsx scripts/bootstrap-initial-admin.ts",
    "facebook:capture": "node --conditions react-server --import tsx scripts/facebook-capture.ts",
    "youtube:capture": "node --conditions react-server --import tsx scripts/youtube-capture.ts",
    "capture-cache:migrate": "tsx scripts/capture-cache-migrate.ts",
    "knowledge:extraction-worker": "node --conditions react-server --import tsx scripts/knowledge-extraction-worker.ts",
    "knowledge:ingestion-worker": "node --conditions react-server --import tsx scripts/knowledge-ingestion-worker.ts",
    "knowledge:indexing-worker": "node --conditions react-server --import tsx scripts/knowledge-indexing-worker.ts",
    "trip-proposal-expiry": "node --import tsx scripts/trip-proposal-expiry.ts",
    "knowledge:source-retention": "node --conditions react-server --import tsx scripts/knowledge-source-retention.ts",
    "knowledge:assistant-provenance-withdrawal-backfill": "node --import tsx scripts/assistant-provenance-withdrawal-backfill.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@neondatabase/serverless": "^1.0.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@xuyenviet/worker-domain": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.2.3",
    "next": "^15.3.5",
    "next-auth": "5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^15.3.5",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.26.2"
}
